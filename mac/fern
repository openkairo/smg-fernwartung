PROFIL = os.path.join(ORDNER, "claude-profil")
CHAT = os.path.join(ORDNER, "chat")
REGELN = os.path.join(os.path.dirname(os.path.realpath(__file__)), "kundensitzung.md")
VORLAGE = {
    "ssh_ziel": "root@SERVER",
    "ssh_schluessel": "~/.ssh/id_ed25519_hostinger",
    "techniker_port": 8811,
    "techniker_schluessel": "",
    "claude": "claude",
    # "profil": eigenes Claude-Profil über das Abo (einmal anmelden)
    # "api":    --bare mit API-Schlüssel aus api_schluessel_datei
    "claude_modus": "profil",
    "api_schluessel_datei": "",
}


def ende(text, code=1):
    print(text, file=sys.stderr)
    sys.exit(code)


def konfig_laden():
    if not os.path.exists(KONFIG):
        ende("Noch nicht eingerichtet. Bitte zuerst: fern einrichten")
    if os.stat(ORDNER).st_mode & 0o077 or os.stat(KONFIG).st_mode & 0o077:
        ende(f"Rechte zu offen. Bitte: chmod 700 {ORDNER} && chmod 600 {KONFIG}")
    with open(KONFIG) as f:
        k = {**VORLAGE, **json.load(f)}
    if not k["techniker_schluessel"]:
        ende(f"In {KONFIG} fehlt der Techniker-Schlüssel.")
    return k


def einrichten():
    os.makedirs(ORDNER, mode=0o700, exist_ok=True)
    os.chmod(ORDNER, 0o700)
    if not os.path.exists(KONFIG):
        with open(os.open(KONFIG, os.O_WRONLY | os.O_CREAT, 0o600), "w") as f:
            json.dump(VORLAGE, f, indent=2)
        print(f"Angelegt: {KONFIG}\nBitte ssh_ziel und techniker_schluessel eintragen.")
    else:
        os.chmod(KONFIG, 0o600)
        print(f"Vorhanden: {KONFIG} (Rechte geprüft)")
    os.makedirs(PROFIL, mode=0o700, exist_ok=True)
    print(f"Claude-Profil für Kundensitzungen: {PROFIL}\n"
          f"Einmal anmelden mit:  CLAUDE_CONFIG_DIR='{PROFIL}' claude auth login")


def freier_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


class Verbindung:
    """SSH-Weiterleitung zum Techniker-Port des Dienstes. Ohne sie ist der Dienst nicht erreichbar."""

    def __init__(self, k, abgekoppelt=False, leise=False):
        self.k = k
        self.prozess = None
        if k.get("direkt"):  # nur für lokale Tests
            self.basis = k["direkt"]
            return
        port = freier_port()
        self.basis = f"http://127.0.0.1:{port}"
        self.prozess = subprocess.Popen(
            ["ssh", "-N", "-o", "ExitOnForwardFailure=yes", "-o", "BatchMode=yes", "-o", "ServerAliveInterval=15",
             "-i", os.path.expanduser(k["ssh_schluessel"]),
             "-L", f"127.0.0.1:{port}:127.0.0.1:{k['techniker_port']}", k["ssh_ziel"]],
            stdin=subprocess.DEVNULL, start_new_session=abgekoppelt,
            stdout=subprocess.DEVNULL if abgekoppelt else None, stderr=subprocess.DEVNULL if abgekoppelt else None)
        for _ in range(100):
            if self.prozess.poll() is not None:
                if leise:
                    self.prozess = None
                    return
                ende("SSH-Verbindung zum Server kam nicht zustande.")
            try:
                socket.create_connection(("127.0.0.1", port), timeout=0.2).close()
                return
            except OSError:
                time.sleep(0.1)
        self.schliessen()
        if leise:
            self.prozess = None
            return
        ende("SSH-Verbindung zum Server kam nicht zustande (Zeitüberschreitung).")

    def ruf(self, methode, pfad, daten=None):
        anfrage = urllib.request.Request(
            self.basis + pfad, method=methode,
            data=json.dumps(daten).encode() if daten is not None else None,
            headers={"Authorization": "Bearer " + self.k["techniker_schluessel"], "Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(anfrage, timeout=20) as r:
                return r.status, json.load(r)
        except urllib.error.HTTPError as e:
            try:
                return e.code, json.load(e)
            except Exception:
                return e.code, {}

    def schliessen(self):
        if self.prozess and self.prozess.poll() is None:
            self.prozess.terminate()
            try:
                self.prozess.wait(3)
            except subprocess.TimeoutExpired:
                self.prozess.kill()


def verwaltung(k, befehl, argumente):
    v = Verbindung(k)
    try:
        if befehl == "neu":
            status, j = v.ruf("POST", "/geraete", {"seriennummer": argumente[0]})
            if status != 200:
                ende(j.get("fehler", f"Fehler {status}"))
            print(f"Gerät {j['seriennummer']} angelegt. In die Einstellungen der App „SMG Fernwartung“ eintragen:\n")
            print(f"geraetekennung: {j['kennung']}")
            print(f"geraeteschluessel: {j['schluessel']}")
            print("\nDer Geräteschlüssel wird nur dieses eine Mal angezeigt.")
        elif befehl == "sperren":
            status, j = v.ruf("POST", f"/geraete/{argumente[0]}/sperren")
            if status != 200:
                ende(j.get("fehler", f"Fehler {status}"))
            print("Gesperrt." + (" Die laufende Sitzung wurde beendet." if j["sitzung_beendet"] else ""))
        elif befehl == "geraete":
            status, j = v.ruf("GET", "/geraete")
            for g in j:
                print(f"{g['seriennummer']:<20} {g['kennung']}  "
                      f"{'gesperrt' if g['gesperrt'] else 'aktiv':<9} {'verbunden' if g['verbunden'] else ''}")
        elif befehl == "protokoll":
            status, j = v.ruf("GET", "/protokoll")
            for p in j:
                print(f"{p['beginn']}  bis {p['ende'] or 'läuft':<19}  {p['geraet']}  "
                      f"{p['techniker'] or '-':<10} {p['grund'] or ''}")
    finally:
        v.schliessen()


# Auch wenn der Server sie als lesend kennzeichnet: Kamerabilder und Meldungen nach außen nur mit Rückfrage
IMMER_FRAGEN = ("ha_get_camera_image", "ha_report_issue")


def lesende_werkzeuge(k, url):
    """Fragt den MCP-Server des Kunden, welche Werkzeuge nur lesen. Die dürfen ohne Rückfrage laufen."""
    def ruf(methode, nr, parameter=None):
        anfrage = urllib.request.Request(
            url, method="POST",
            data=json.dumps({"jsonrpc": "2.0", "id": nr, "method": methode, "params": parameter or {}}).encode(),
            headers={"Authorization": "Bearer " + k["techniker_schluessel"], "Content-Type": "application/json",
                     "Accept": "application/json, text/event-stream"})
        with urllib.request.urlopen(anfrage, timeout=30) as r:
            text = r.read().decode()
            sitzung = r.headers.get("Mcp-Session-Id")
        daten = [z[5:].strip() for z in text.splitlines() if z.startswith("data:")]
        return json.loads(daten[-1] if daten else text), sitzung
    try:
        ruf("initialize", 1, {"protocolVersion": "2025-06-18", "capabilities": {},
                              "clientInfo": {"name": "fern", "version": "1"}})
        antwort, _ = ruf("tools/list", 2)
        return sorted(w["name"] for w in antwort["result"]["tools"]
                      if (w.get("annotations") or {}).get("readOnlyHint") and w["name"] not in IMMER_FRAGEN)
    except Exception:
        return []


BACKUP_WERKZEUG = "mcp__fern__backup_starten"


def mcp_konfig(k, url):
    """Anschlüsse der Kundensitzung: das Home Assistant des Kunden und der Backup-Helfer, sonst nichts."""
    return {"mcpServers": {
        "kunde": {"type": "http", "url": url, "headers": {"Authorization": "Bearer " + k["techniker_schluessel"]}},
        "fern": {"type": "stdio", "command": sys.executable,
                 "args": [os.path.join(os.path.dirname(os.path.realpath(__file__)), "fern_mcp.py")],
                 "env": {"FERN_URL": url, "FERN_SCHLUESSEL": k["techniker_schluessel"]}}}}


def claude_befehl(k, mcp_datei, erlaubt=(), alle=False):
    """Claude Code nur mit dem Kunden-Anschluss: keine eingebauten Werkzeuge, kein eigener Kontext."""
    befehl = [k["claude"], "--mcp-config", mcp_datei, "--strict-mcp-config", "--tools", "",
              "--setting-sources", "",
              # Kein Browser des Technikers in der Kundensitzung, und Schreibendes fragt immer nach
              "--no-chrome", "--permission-mode", "manual"]
    # Das Backup ohne Passwort darf immer ohne Rückfrage laufen
    if alle:
        befehl += ["--allowedTools", "mcp__kunde," + BACKUP_WERKZEUG]
    else:
        befehl += ["--allowedTools", ",".join(["mcp__kunde__" + name for name in erlaubt] + [BACKUP_WERKZEUG])]
    if os.path.exists(REGELN):
        with open(REGELN) as f:
            befehl += ["--append-system-prompt", f.read()]
    umgebung = {n: w for n, w in os.environ.items()
                if not n.startswith(("CLAUDE", "ANTHROPIC", "MCP_"))}
    if k["claude_modus"] == "api":
        with open(os.path.expanduser(k["api_schluessel_datei"])) as f:
            umgebung["ANTHROPIC_API_KEY"] = f.read().strip()
        befehl.append("--bare")
    else:
        umgebung["CLAUDE_CONFIG_DIR"] = PROFIL
    return befehl, umgebung


def uebernehmen(v, fern_id):
    status, j = v.ruf("POST", "/uebernahme/beginn", {"id": fern_id})
    if status != 200:
        v.schliessen()
        ende(j.get("fehler", f"Fehler {status}"))
    token = j["token"]
    for versuch in range(3):  # derselbe Token: Wiederholung liefert dieselbe Sitzung
        status, j = v.ruf("POST", "/uebernahme/abschluss", {"token": token})
        if status in (200, 409, 410):
            break
        time.sleep(1)
    if status != 200:
        v.schliessen()
        ende(j.get("fehler", f"Fehler {status}"))
    return j


def dauer(sekunden):
    minuten = max(0, int(sekunden)) // 60
    return f"{minuten} Minuten" if minuten < 60 else f"{minuten // 60} Std. {minuten % 60} Min"


def acht_ziffern(fern_id):
    fern_id = "".join(c for c in fern_id if c.isdigit())
    if len(fern_id) != 8:
        ende("Die Fernwartungs-ID hat acht Ziffern.")
    return fern_id


# ---------- Chat-Sitzung: Aufträge einzeln hineinreichen, statt Claude im Terminal zu bedienen ----------

def chat_zustand():
    try:
        with open(os.path.join(CHAT, "zustand.json")) as f:
            return json.load(f)
    except Exception:
        return None


def chat_speichern(z):
    with open(os.open(os.path.join(CHAT, "zustand.json"), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(z, f)


def sitzung_schliessen(k, url):
    """Sagt dem Dienst, dass der Techniker fertig ist. Die App beim Kunden zeigt dann sofort „aus“.

    Rückgabe: True, wenn die Sitzung im Dienst sicher zu ist (jetzt geschlossen oder schon beendet).
    Ist die bestehende Weiterleitung tot, wird dafür eine frische aufgebaut.
    """
    pfad = urllib.parse.urlsplit(url).path.rsplit("/", 1)[0] + "/ende"

    def versuch(basis):
        anfrage = urllib.request.Request(basis + pfad, method="POST", data=b"{}",
                                         headers={"Authorization": "Bearer " + k["techniker_schluessel"],
                                                  "Content-Type": "application/json"})
        try:
            urllib.request.urlopen(anfrage, timeout=10).read()
            return True
        except urllib.error.HTTPError as e:
            return e.code == 410  # schon beendet: auch gut
        except Exception:
            return None  # Dienst nicht erreicht

    basis = "{0.scheme}://{0.netloc}".format(urllib.parse.urlsplit(url))
    ergebnis = versuch(basis)
    if ergebnis is None and not k.get("direkt"):
        try:
            v = Verbindung(k, leise=True)
        except Exception:
            return False
        if v.prozess is None:
            return False
        try:
            ergebnis = versuch(v.basis)
        finally:
            v.schliessen()
    return bool(ergebnis)


def chat_ende(leise=False, k=None):
    z = chat_zustand()
    zu = sitzung_schliessen(k, z["url"]) if z and k else None
    if z and z.get("pid"):
        try:
            os.kill(z["pid"], 15)
        except OSError:
            pass
    shutil.rmtree(CHAT, ignore_errors=True)
    if leise:
        return
    if not z:
        print("Es war keine Fernwartung aktiv.")
    elif zu:
        print("Fernwartung beendet: Sitzung beim Kunden geschlossen (die App dort zeigt „aus“), Sitzungsdaten gelöscht.")
    else:
        print("ACHTUNG: Sitzungsdaten auf dem Mac gelöscht, aber der Dienst war nicht erreichbar. "
              "Beim Kunden läuft die Fernwartung noch, bis er sie beendet, eine Stunde nichts geschieht "
              "oder die Frist abläuft. Mit „fern protokoll“ prüfen.")


def chat_start(k, fern_id):
    fern_id = acht_ziffern(fern_id)
    chat_ende(leise=True, k=k)
    v = Verbindung(k, abgekoppelt=True)
    j = uebernehmen(v, fern_id)
    os.makedirs(CHAT, mode=0o700)
    arbeit = os.path.join(ORDNER, "arbeit")
    shutil.rmtree(arbeit, ignore_errors=True)
    os.mkdir(arbeit, 0o700)
    url = f"{v.basis}/s/{j['sitzung']}/mcp"
    with open(os.open(os.path.join(CHAT, "mcp.json"), os.O_WRONLY | os.O_CREAT, 0o600), "w") as f:
        json.dump(mcp_konfig(k, url), f)
    lesend = lesende_werkzeuge(k, url)
    chat_speichern({"pid": v.prozess.pid if v.prozess else None, "url": url, "claude_sitzung": str(uuid.uuid4()),
                    "erster": True, "ende": time.time() + j["restzeit"], "lesend": lesend, "schreiben": False})
    print(f"Sitzung übernommen, noch {dauer(j['restzeit'])}. "
          f"{len(lesend)} lesende Werkzeuge laufen ohne Rückfrage, alles Schreibende braucht eine Freigabe.\n"
          "Zur Erinnerung: Das Backup macht der Kunde vor der Sitzung selbst.")


def chat_lebt(k, z):
    """True: Sitzung lebt. False: im Dienst beendet. None: Dienst über die Weiterleitung nicht erreichbar."""
    anfrage = urllib.request.Request(
        z["url"], method="POST", data=json.dumps({"jsonrpc": "2.0", "id": 1, "method": "ping"}).encode(),
        headers={"Authorization": "Bearer " + k["techniker_schluessel"], "Content-Type": "application/json",
                 "Accept": "application/json, text/event-stream"})
    try:
        urllib.request.urlopen(anfrage, timeout=20).read()
        return True
    except urllib.error.HTTPError as e:
        return e.code not in (401, 410)
    except Exception:
        return None


def chat_aktiv(k):
    z = chat_zustand()
    if not z:
        ende("Keine Fernwartung aktiv. Start mit: fern start <ID>")
    lebt = chat_lebt(k, z) if time.time() < z["ende"] else False
    if lebt is None and not k.get("direkt"):
        # Die Weiterleitung ist abgerissen (Ruhezustand, Netzwechsel): neu aufbauen statt die Sitzung aufzugeben
        if z.get("pid"):
            try:
                os.kill(z["pid"], 15)
            except OSError:
                pass
        v = Verbindung(k, abgekoppelt=True)
        z["pid"] = v.prozess.pid
        z["url"] = v.basis + urllib.parse.urlsplit(z["url"]).path
        chat_speichern(z)
        with open(os.open(os.path.join(CHAT, "mcp.json"), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            json.dump(mcp_konfig(k, z["url"]), f)
        lebt = chat_lebt(k, z)
    if not lebt:
        chat_ende(leise=True, k=k)
        ende("Die Fernwartung ist beendet (Zeit abgelaufen, vom Kunden ausgeschaltet oder Verbindung verloren). "
             "Für eine neue Sitzung muss der Kunde neu einschalten.")
    return z


def bild_block(pfad):
    """Bild als Anhang für Claude; große Bilder werden vorher verkleinert."""
    pfad = os.path.expanduser(pfad)
    if not os.path.isfile(pfad):
        ende(f"Bild nicht gefunden: {pfad}")
    art = mimetypes.guess_type(pfad)[0] or ""
    quelle = pfad
    if art not in ("image/png", "image/jpeg", "image/gif", "image/webp") or os.path.getsize(pfad) > 3_000_000:
        quelle = os.path.join(CHAT, "bild-%d.jpg" % time.time_ns())
        if subprocess.run(["sips", "-s", "format", "jpeg", "-Z", "2000", pfad, "--out", quelle],
                          capture_output=True).returncode != 0:
            ende(f"Bild lässt sich nicht lesen: {pfad}")
        art = "image/jpeg"
    with open(quelle, "rb") as f:
        daten = base64.b64encode(f.read()).decode()
    if quelle != pfad:
        os.remove(quelle)
    return {"type": "image", "source": {"type": "base64", "media_type": art, "data": daten}}


def chat_frag(k, argumente):
    z = chat_aktiv(k)
    einmal, bilder = [], []
    while argumente and argumente[0] in ("--erlaube", "--bild"):
        if len(argumente) < 3:
            ende("Aufruf: fern frag [--erlaube <werkzeug,werkzeug|alle>] [--bild <Datei>]... <Auftrag>")
        if argumente[0] == "--bild":
            bilder.append(bild_block(argumente[1]))
        elif argumente[1] == "alle":
            z["schreiben"] = True
        else:
            einmal = [w.replace("mcp__kunde__", "") for w in argumente[1].split(",") if w]
        argumente = argumente[2:]
    auftrag = " ".join(argumente).strip()
    if not auftrag:
        ende("Der Auftrag fehlt.")
    befehl, umgebung = claude_befehl(k, os.path.join(CHAT, "mcp.json"), z["lesend"] + einmal, alle=z["schreiben"])
    # Der Auftrag geht als Nachricht über die Standardeingabe hinein, damit Bilder mitkönnen
    befehl += ["-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose",
               "--session-id" if z["erster"] else "--resume", z["claude_sitzung"]]
    nachricht = json.dumps({"type": "user", "message": {"role": "user",
                            "content": bilder + [{"type": "text", "text": auftrag}]}}) + "\n"
    try:
        lauf = subprocess.run(befehl, cwd=os.path.join(ORDNER, "arbeit"), env=umgebung, input=nachricht,
                              capture_output=True, text=True, timeout=max(30, z["ende"] - time.time()))
    except subprocess.TimeoutExpired:
        ende("Abgebrochen: Die Sitzungszeit ist während des Auftrags abgelaufen. Stand am Gerät vor dem Weiterarbeiten prüfen.")
    z["erster"] = False
    chat_speichern(z)
    antwort = None
    for zeile in lauf.stdout.splitlines():
        try:
            m = json.loads(zeile)
        except Exception:
            continue
        if m.get("type") == "result":
            antwort = m
    if antwort is None:
        ende("Claude hat nicht geantwortet:\n" + (lauf.stdout + lauf.stderr).strip()[-1500:])
    print(str(antwort.get("result", "")).strip())
    abgelehnt = antwort.get("permission_denials") or []
    if abgelehnt:
        print("\n--- FREIGABE NÖTIG: Diese Aufrufe wurden nicht ausgeführt ---")
        gesehen = set()
        for a in abgelehnt:
            name = str(a.get("tool_name", "")).replace("mcp__kunde__", "")
            eingabe = json.dumps(a.get("tool_input", {}), ensure_ascii=False)
            if (name, eingabe) in gesehen:
                continue
            gesehen.add((name, eingabe))
            print(f"- {name}: {eingabe[:600]}{' …' if len(eingabe) > 600 else ''}")
        print("Freigeben mit: fern frag --erlaube " + ",".join(sorted({n for n, _ in gesehen})) + ' "Freigegeben, bitte ausführen."')
    print(f"\n(Fernwartung: noch {dauer(z['ende'] - time.time())})")


def chat_backup(k):
    """Startet ein vollständiges Backup über den Home-Assistant-Dienst hassio.backup_full.

    Der braucht kein Backup-Passwort (das Backup ist dann unverschlüsselt). Läuft ohne Claude,
    direkt als Werkzeugaufruf über die Weiterleitung.
    """
    z = chat_aktiv(k)
    name = "Fernwartung " + time.strftime("%Y-%m-%d %H:%M")

    def ruf(nr, methode, parameter):
        anfrage = urllib.request.Request(
            z["url"], method="POST",
            data=json.dumps({"jsonrpc": "2.0", "id": nr, "method": methode, "params": parameter}).encode(),
            headers={"Authorization": "Bearer " + k["techniker_schluessel"], "Content-Type": "application/json",
                     "Accept": "application/json, text/event-stream"})
        with urllib.request.urlopen(anfrage, timeout=900) as r:
            text = r.read().decode()
        daten = [zeile[5:].strip() for zeile in text.splitlines() if zeile.startswith("data:")]
        return json.loads(daten[-1] if daten else text)
    try:
        ruf(1, "initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                              "clientInfo": {"name": "fern", "version": "1"}})
        antwort = ruf(2, "tools/call", {"name": "ha_call_service", "arguments": {
            "domain": "hassio", "service": "backup_full", "data": {"name": name}}})
    except Exception as e:
        ende(f"Backup nicht gestartet: {type(e).__name__}. Stand am Gerät prüfen, nicht blind wiederholen.")
    ergebnis = antwort.get("result", {})
    text = " ".join(c.get("text", "") for c in ergebnis.get("content", []) if c.get("type") == "text")
    if "error" in antwort or ergebnis.get("isError"):
        ende("Backup fehlgeschlagen: " + (text or json.dumps(antwort.get("error"), ensure_ascii=False))[:600])
    print(f"Backup „{name}“ ist angelegt (vollständig, unverschlüsselt, ohne Passwort).")


def chat_status(k):
    z = chat_aktiv(k)
    print(f"Fernwartung aktiv, noch {dauer(z['ende'] - time.time())}. "
          f"Schreiben: {'für die ganze Sitzung freigegeben' if z['schreiben'] else 'nur mit Freigabe je Auftrag'}.")


def sitzung(k, fern_id):
    fern_id = acht_ziffern(fern_id)
    def abbruch(nummer, rahmen):
        raise SystemExit(1)
    for s in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(s, abbruch)
    v = Verbindung(k)
    url = None
    temp = tempfile.mkdtemp(prefix="smg-fern-")
    try:
        j = uebernehmen(v, fern_id)
        # Festes, leeres Arbeitsverzeichnis: Claude Code fragt die Ordnerfreigabe dann nur beim ersten Mal
        arbeit = os.path.join(ORDNER, "arbeit")
        shutil.rmtree(arbeit, ignore_errors=True)
        os.mkdir(arbeit, 0o700)
        mcp_datei = os.path.join(temp, "mcp.json")
        with open(os.open(mcp_datei, os.O_WRONLY | os.O_CREAT, 0o600), "w") as f:
            json.dump(mcp_konfig(k, f"{v.basis}/s/{j['sitzung']}/mcp"), f)
        erlaubt = lesende_werkzeuge(k, f"{v.basis}/s/{j['sitzung']}/mcp")
        print(f"Sitzung übernommen, noch {dauer(j['restzeit'])}. "
              f"{len(erlaubt)} lesende Werkzeuge laufen ohne Rückfrage. "
              "Das Backup macht der Kunde vor der Sitzung selbst. Claude startet …")
        befehl, umgebung = claude_befehl(k, mcp_datei, erlaubt)
        url = f"{v.basis}/s/{j['sitzung']}/mcp"
        subprocess.call(befehl, cwd=arbeit, env=umgebung)
    finally:
        # Läuft auch, wenn das Terminal geschlossen oder der Prozess beendet wird (siehe Signale unten)
        zu = sitzung_schliessen(k, url) if url else None
        shutil.rmtree(temp, ignore_errors=True)
        v.schliessen()
        try:
            print("Fernwartung beendet: Sitzung beim Kunden geschlossen, temporäre Konfiguration gelöscht." if zu
                  else "Temporäre Konfiguration gelöscht." if zu is None
                  else "ACHTUNG: Dienst nicht erreichbar, beim Kunden läuft die Fernwartung noch. Mit „fern protokoll“ prüfen.")
        except Exception:
            pass


def haupt():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "hilfe"):
        ende(__doc__, 0)
    if a[0] == "einrichten":
        return einrichten()
    k = konfig_laden()
    if a[0] in ("neu", "sperren") and len(a) == 2:
        verwaltung(k, a[0], a[1:])
    elif a[0] in ("geraete", "protokoll") and len(a) == 1:
        verwaltung(k, a[0], [])
    elif a[0] == "start" and len(a) in (2, 3):
        chat_start(k, "".join(a[1:]))
    elif a[0] == "frag":
        chat_frag(k, a[1:])
    elif a[0] == "backup" and len(a) == 1:
        chat_backup(k)
    elif a[0] == "status" and len(a) == 1:
        chat_status(k)
    elif a[0] == "ende" and len(a) == 1:
        chat_ende(k=k)
    elif len(a) <= 2 and "".join(a).replace(" ", "").isdigit():
        sitzung(k, "".join(a))
    else:
        ende(__doc__)


if __name__ == "__main__":
    haupt()
