#!/usr/bin/env python3
"""fern: Techniker-Werkzeug für die SMG Fernwartung.

  fern <ID>                 Kundensitzung im Terminal starten (ID aus der App des Kunden)
  fern start <ID>           Kundensitzung für den Chat starten (läuft im Hintergrund weiter)
  fern frag [--erlaube a,b|alle] [--bild <Datei>]... <Auftrag>
                            einen Auftrag an die Chat-Sitzung geben, Antwort ausgeben
  fern backup               vollständiges Backup auf dem Kundengerät starten (ohne Backup-Passwort)
  fern status               Stand der Chat-Sitzung
  fern ende                 Chat-Sitzung beenden
  fern neu <Seriennummer>   Gerät in der Werkstatt anlegen, App-Einstellungen ausgeben
  fern sperren <Gerät>      Gerät sperren (Seriennummer oder Gerätekennung), laufende Sitzung endet sofort
  fern geraete              Geräteliste
  fern protokoll            letzte Sitzungen
  fern einrichten           Konfiguration anlegen und prüfen

Geheime Daten liegen in ~/.config/smg-fern/ (Verzeichnis 700, Dateien 600), nie im Vault.
"""
